# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.env/   # por si alguien crea un directorio .env accidentalmente

# Environment variables files (keep secrets out of repo)
.env
.env.*           # opcional: ignora .env.local, .env.production, etc.

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# MyPy / type checkers
.mypy_cache/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Database files (if you use local sqlite during dev)
*.sqlite3
*.db
*.db-journal

# Docker
docker-compose.override.yml
.env.docker

# Python virtual env created by some tools
.python-version

# Static / build artifacts from frontend tooling (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage reports
coverage/

# Temp files
*.tmp
*.swp